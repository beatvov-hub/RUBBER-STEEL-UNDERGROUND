{
  "name": "rubber-steel-underground",
  "version": "1.0.0",
  "private": true,
  "description": "Permanent ricochet action roguelite / 50 stages and 500 floors",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "desktop": "npm run build && electron .",
    "package:win": "npm run build && node node_modules/electron/install.js && electron-builder --win zip",
    "test:playthrough": "tsx scripts/playthrough.ts",
    "test:browser": "node scripts/smoke.mjs",
    "test:mobile": "node scripts/mobile-smoke.mjs",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "test:debug": "node scripts/debug-smoke.mjs",
    "verify:content": "tsx scripts/verify-content.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "local.rsu.game",
    "productName": "RUBBER_STEEL_UNDERGROUND",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "readme_ja.txt",
        "to": "readme_ja.txt"
      }
    ],
    "win": {
      "target": "zip",
      "signAndEditExecutable": false
    }
  }
}
